# SILT Lista — serwer aplikacji: blokada dostępu do konfiguracji i plików wewnętrznych
Options -Indexes

<FilesMatch "^(config.*\.php|.*\.sql|.*\.md)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>

RedirectMatch 403 /(lib|sql|testy)/

# Krótkie adresy bez „.php”: /lista-api/plan → plan.php, /lista-api/panel → panel.php
RedirectMatch 302 ^(.*)/(plan|panel)/?$ $1/$2.php
